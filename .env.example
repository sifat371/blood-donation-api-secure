# Backend configuration — copy to `.env` and fill in real values.
#
#     cp .env.example .env
#
# This file is committed on purpose and must never contain a real secret. `.env`
# itself is gitignored. Every variable below maps to a field on `Settings` in
# app/core/config.py; anything you leave out falls back to the default shown.
# Names are case-insensitive.

# ── Application ──────────────────────────────────────────
APP_NAME="Blood Donation API"

# `development` | `production`
# In production the app refuses to pair CORS_ORIGINS="*" with credentials, and
# /health reports this value so you can tell which config a device is talking to.
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────
# SQLite by default; the file is created on first start, relative to backend/.
DATABASE_URL=sqlite:///./blood_donation.db

# Log every SQL statement. Very noisy — leave false unless debugging a query.
DB_ECHO=false

# ── Authentication ───────────────────────────────────────
# SECRET_KEY signs every JWT. REQUIRED in production: the default in config.py
# is a placeholder, and anyone who knows it can mint a token for any account.
# Generate a fresh one per environment:
#
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Changing it invalidates all issued tokens, which signs every user out.
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Sign-In. Use the **Web** client id from the Google Cloud console (the
# Android/iOS client ids are not what the backend verifies the ID token
# against), and set the same value as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID in
# frontend/.env. Leave blank to use POST /api/v1/auth/dev-login instead.
GOOGLE_CLIENT_ID=

# ── AI chat (optional) ───────────────────────────────────
# Gemini API key. When blank, /api/v1/chat/message still works — it runs the
# rule-based fallback in app/services/chat_agent.py, which answers eligibility,
# donor-search, nearby-request, history and profile questions from real database
# data but does not handle free-form conversation.
GEMINI_API_KEY=

# ── Push notifications (optional) ────────────────────────
# Path to the Firebase service-account JSON, relative to backend/ or absolute.
# When blank, app/core/firebase.py falls back to app/serviceAccount.json.
# Push is disabled — never fatal — if neither exists: in-app notification rows
# are still written and GET /api/v1/notifications still works. Check which
# happened via `push_notifications` in GET /health.
FCM_CREDENTIALS_PATH=

# ── CORS ─────────────────────────────────────────────────
# Comma-separated allowed origins, or "*" for any.
#
# "*" is fine for development and is what Expo Web needs when Metro picks a
# fresh port. It is ignored in production (ENVIRONMENT=production), because "*"
# cannot be combined with credentials per the CORS spec — set the real origins:
#
#     CORS_ORIGINS=https://app.example.com,https://admin.example.com
#
# Native iOS/Android builds are not subject to CORS at all; this only matters
# for the web build.
CORS_ORIGINS=*

# ── Password & email verification ────────────────────────
# Minimum password length enforced by POST /api/v1/auth/signup. bcrypt ignores
# anything past 72 *bytes*, so the backend rejects longer passwords outright
# rather than silently truncating them (two long passwords would otherwise
# collide).
PASSWORD_MIN_LENGTH=8

# Verification code shape and lifetime. The code is generated with `secrets`,
# stored only as an HMAC keyed with SECRET_KEY, single-use, and burned after
# EMAIL_VERIFICATION_MAX_ATTEMPTS wrong guesses.
EMAIL_VERIFICATION_CODE_DIGITS=6
EMAIL_VERIFICATION_TTL_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Per-account cooldown between "resend code" requests, on top of the per-IP
# rate limit on the endpoint.
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# ── Outbound mail ────────────────────────────────────────
# auto   → smtp when SMTP_HOST is set, otherwise outbox (the default)
# smtp   → always a real server; a missing SMTP_HOST raises instead of
#          quietly writing verification codes to disk. Use this in production.
# outbox → write each message to backend/<MAIL_OUTBOX_DIR>/*.eml. For a
#          development machine with no mail server: the code is still generated,
#          stored hashed and checked by the backend, so the flow exercised is the
#          real one. Codes are never returned through the API or written to logs.
MAIL_BACKEND=auto

# SMTP credentials belong here and ONLY here — never in frontend/.env, because
# every EXPO_PUBLIC_* variable is compiled into the APK and readable by anyone
# who unzips it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Envelope sender. Falls back to SMTP_USER, then a local placeholder.
MAIL_FROM=
MAIL_FROM_NAME=Blood Donation

# Where the outbox backend writes .eml files, relative to backend/.
MAIL_OUTBOX_DIR=dev_outbox
